
/* General Styling */
body {
  font - family : -apple - system, BlinkMacSystemFont, "Segoe UI",
      "Helvetica Neue", Helvetica, Roboto, Arial, "PingFang TC",
      "Microsoft JhengHei", "微軟正黑", sans - serif, "Apple Color Emoji",
      "Segoe UI Emoji", "Segoe UI Symbol";
  line - height : 1.8;
color:
# 333;
  background - color : #fff;
margin:
  2em;
  font - size : 12px; /* Reduced base font size */
}

/* Headings */
h1 { font - size : 1.5em; /* Smaller headings */ }

h2 { font - size : 1.375em; }

h3 { font - size : 1.25em; }

h4 { font - size : 1.125em; }

h5 { font - size : 1em; }

h6 { font - size : 0.875em; }

/* Paragraphs */
p { font - size : 12px; /* Adjusted paragraph font size */ }

/* Lists */
li { font - size : 12px; /* Adjusted list item font size */ }

/* Tables */
th, td { font - size : 12px; /* Adjusted table font size */ }

/* Code Blocks */
pre, code { font - size : 11px; /* Adjusted code block font size */ }

/* Blockquotes */
blockquote { font - size : 12px; /* Adjusted blockquote font size */ }
